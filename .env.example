# ==============================================================================
# VERCEL / SERVER-SIDE ENVIRONMENT VARIABLES (Never prefix with REACT_APP_)
# ==============================================================================
# 1. OpenAI API (Engine for Vision Analysis & Prompt Generator)
OPENAI_API_KEY=sk-proj-your-actual-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# 2. Database & Supabase Server Secrets
MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ugc_prompt_studio
DB_NAME=ugc_prompt_studio
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 3. Monetization & Security
CORS_ORIGINS=*
GENERATE_CREDIT_COST=10

# ==============================================================================
# FRONTEND / CLIENT ENVIRONMENT VARIABLES (Safe for browser bundle)
# ==============================================================================
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-public-key-here
